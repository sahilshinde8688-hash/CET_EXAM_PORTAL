# Backend-only Supabase credentials. Never expose the service role key in the frontend.
SUPABASE_URL=https://oexapzfmvwkrhqgbwnjn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key

# JWT Secret Key
JWT_SECRET=your_super_secret_jwt_key_change_this
SESSION_INACTIVITY_TIMEOUT_MINUTES=30

# Notes-to-questions AI (server only)
OPENAI_API_KEY=your_openai_api_key
NOTES_QUESTION_MODEL=gpt-4o-mini

# OpenRouter AI
OPENROUTER_API_KEY=your_openrouter_api_key
# Optional server-only fallback, tried if the primary request fails
OPENROUTER_API_KEY_BACKUP=your_openrouter_api_key_backup

# Server Port
PORT=5000

# Frontend URL (for CORS)
FRONTEND_URL=https://your-vercel-domain.vercel.app
CLIENT_URL=http://localhost:5173

# Python SMTP mailer (run cet-api/python-email-service/server.py locally)
PYTHON_EMAIL_SERVICE_URL=http://localhost:8000
PYTHON_EMAIL_SERVICE_TOKEN=replace_with_a_long_random_shared_secret
EMAIL_SENDER_EMAIL=sender@example.test
EMAIL_SENDER_NAME=CETNova
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=sender@example.test
EMAIL_SMTP_PASSWORD=replace_with_a_rotated_gmail_app_password
EMAIL_SMTP_FROM=sender@example.test
# Use the same random 32+ character secret on the API and scheduler
EMAIL_TOKEN_ENCRYPTION_KEY=replace_with_a_shared_random_secret_at_least_32_characters
# Public API origin used for secure parent report links
PUBLIC_API_URL=http://localhost:5000

# Optional: Cloudinary configuration for image uploads
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# Optional: Redis URL for production rate limiting
REDIS_URL=redis://localhost:6379

# PDF question extraction (admin only). Uploads are processed in memory —
# nothing is ever written to disk.
# Maximum accepted PDF upload size in MB
PDF_MAX_UPLOAD_MB=20
# Hard cap on parsed pages per PDF (DoS guard; larger PDFs are truncated)
PDF_MAX_PAGES=150
# Maximum pages OCR'd for scanned PDFs (OCR is slow — keep this modest)
PDF_OCR_MAX_PAGES=40
# Tesseract language(s) for OCR, e.g. eng, eng+hin
PDF_OCR_LANG=eng
# Optional: custom tessdata directory with the language traineddata files
# PDF_OCR_LANG_PATH=
# Overall deadline for a single extraction job in milliseconds
PDF_PROCESS_TIMEOUT_MS=180000
