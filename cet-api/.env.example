# Copy this file to .env and fill in your values.
# Never commit real credentials to GitHub.

# MongoDB Connection String (from MongoDB Atlas or local)
MONGO_URI=your_mongodb_connection_string

# JWT Secret Key (make this a long random string)
JWT_SECRET=your_super_secret_jwt_key_change_this

# Server Port (Render provides this automatically)
PORT=5000

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Optional: Cloudinary configuration for image uploads
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# Optional: Redis URL for production rate limiting
REDIS_URL=redis://localhost:6379

# Optional: Email service for approval/rejection notifications
EMAIL_SERVICE_URL=http://localhost:8000
