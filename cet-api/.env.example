# Copy this file to .env and fill in your values

# MongoDB Connection String (from MongoDB Atlas or local)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/cetprepro?retryWrites=true&w=majority

# JWT Secret Key (make this a long random string)
JWT_SECRET=your_super_secret_jwt_key_change_this

# Server Port
PORT=5000

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
